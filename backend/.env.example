# BreatheWise AI - Environment Configuration Example

# Groq API Key (Optional but recommended for full GenAI features)
# If omitted or unavailable, BreatheWise automatically switches to its built-in rule-based expert intelligence engine.
GROQ_API_KEY=your_groq_api_key_here

# Groq Model (default: llama-3.3-70b-versatile or llama-3.1-8b-instant)
GROQ_MODEL=llama-3.3-70b-versatile

# Server Port & Host
PORT=8000
HOST=0.0.0.0

# Frontend URL for CORS (comma separated if multiple)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://breathewise-ai.vercel.app

# OpenAQ API Key (Optional: Open-Meteo Air Quality requires 0 keys and is primary)
OPENAQ_API_KEY=
